# Leave empty in dev (Vite proxies to http://localhost:4000).
# Set to the deployed service URL for production builds, e.g. https://my-app.onrender.com
VITE_API_URL=

# Google OAuth "Web application" client ID. Must be the SAME client ID as GOOGLE_CLIENT_ID in service/.env.
# Google Cloud Console → Google Auth Platform → Clients → your web client:
#   Authorised JavaScript origins:  http://localhost:5173   (+ your production URL)
#   Authorised redirect URIs:       http://localhost:5173/auth/callback   (+ https://<your-site>/auth/callback)
VITE_GOOGLE_CLIENT_ID=

# Public address of this web app, e.g. https://mail-tracker.example.com
# Used at build time for the canonical link, link-preview image and sitemap.xml. Leave empty locally.
VITE_SITE_URL=

# Shown on the privacy page (/privacy) for questions and account deletion requests. Public, so use an address you
# don't mind being seen. Leave empty to show a generic "contact the person who runs this" line instead.
VITE_CONTACT_EMAIL=
