{
  // Used by the editor, `npm run typecheck` and ESLint. Covers source, tests and config files.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src", "tests", "prisma.config.ts", "vitest.config.ts"]
}
