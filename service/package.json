{
  "name": "mail-tracker-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Mail Tracker: a REST API that tracks when recruiters open your job-application emails.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cors": "^2.0.0",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cors": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
