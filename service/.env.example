# Copy this file to .env and fill in the values. Never commit .env.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Neon → your project → Connect → copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Public address of this service. Tracker links in your emails point here.
# Locally: http://localhost:4000   On Render: https://<your-app>.onrender.com
PUBLIC_BASE_URL=http://localhost:4000

# Hits within this many seconds of creating a tracker are ignored (your own draft loading the pixel)
TRACKING_GRACE_PERIOD_SECONDS=60

# ── Auth: "Sign in with Google" ─────────────────────────────────────
# Google Cloud Console → Google Auth Platform → Clients → your Web client → Client ID (not a secret)
GOOGLE_CLIENT_ID=

# Signs session tokens. Keep it secret; changing it signs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How many days you stay signed in
SESSION_TTL_DAYS=30

# The web app's address(es), comma-separated, https:// in production, e.g. https://seenly-app.onrender.com
# Allowed to call the API with the session cookie, and accepted by the Origin check on changes.
# Leave empty locally (Vite's proxy makes the web app and API the same address).
CORS_ORIGINS=

# How many proxies sit in front of the service and add X-Forwarded-For. 1 = Render alone.
# After deploying, check it's right (DEPLOY.md, "Check the real IP reaches the service").
TRUST_PROXY_HOPS=1
